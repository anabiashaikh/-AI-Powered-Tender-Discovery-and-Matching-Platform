# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_SSL=true

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# Demo Mode (Presentation Fallback)
DEMO_MODE=true
DEMO_EMAIL=admin@tenderdiscovery.com
DEMO_PASSWORD=Admin123!

# Redis
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_TLS=true

# App
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://ai-powered-tender-discovery-and-mat.vercel.app,http://localhost:3000
FRONTEND_URL=https://ai-powered-tender-discovery-and-mat.vercel.app
